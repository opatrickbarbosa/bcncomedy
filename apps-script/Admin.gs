function admin_(d) {
  const key = adminKey_();
  if (!key || d.key !== key) return json_({ ok: false, error: 'auth' });
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    if (d.action === 'load') {
      const data = {}; Object.keys(COLL).forEach(c => data[c] = rows_(c));
      data.signups = signups_();
      return json_({ ok: true, data: data, sheet: book_().getUrl() });
    }
    if (d.action === 'save' && COLL[d.collection]) { upsert_(d.collection, d.row || {}); return json_({ ok: true }); }
    if (d.action === 'delete' && COLL[d.collection]) { del_(d.collection, String(d.id)); return json_({ ok: true }); }
    return json_({ ok: false, error: 'action' });
  } finally { lock.releaseLock(); }
}

function book_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty(ADMIN.PROP);
  if (id) { try { return SpreadsheetApp.openById(id); } catch (e) {} }
  const ss = SpreadsheetApp.create(ADMIN.NAME);
  props.setProperty(ADMIN.PROP, ss.getId());
  return ss;
}

function sh_(c) {
  const ss = book_();
  let s = ss.getSheetByName(c);
  if (!s) {
    s = ss.insertSheet(c);
    s.getRange(1, 1, 1, COLL[c].length).setValues([COLL[c]]).setFontWeight('bold');
    s.setFrozenRows(1);
    s.getRange('A:Z').setNumberFormat('@');          // keep everything as typed (dates as text)
    if (SEED[c]) s.getRange(2, 1, SEED[c].length, COLL[c].length).setValues(SEED[c].map(r => r.map(v => String(v))));
    ['Sheet1', 'Página1', 'Hoja 1'].forEach(n => { const x = ss.getSheetByName(n); if (x && ss.getSheets().length > 1) ss.deleteSheet(x); });
  }
  const h = s.getRange(1, 1, 1, COLL[c].length).getValues()[0];          // add new columns to old tabs
  if (h.join('|') !== COLL[c].join('|')) { s.getRange(1, 1, 1, COLL[c].length).setValues([COLL[c]]).setFontWeight('bold'); s.getRange(1, 1, s.getMaxRows(), COLL[c].length).setNumberFormat('@'); }
  return s;
}

function rows_(c) {
  const v = sh_(c).getDataRange().getValues();
  const h = v.shift();
  return v.filter(r => r[0] !== '').map(r => {
    const o = {};
    h.forEach((k, i) => {
      let x = r[i];
      if (x instanceof Date) x = x.getFullYear() < 1901 ? Utilities.formatDate(x, 'Europe/Madrid', 'HH:mm') : Utilities.formatDate(x, 'Europe/Madrid', 'yyyy-MM-dd');
      o[k] = x;
    });
    return o;
  });
}

function upsert_(c, row) {
  const s = sh_(c), cols = COLL[c];
  const id = String(row.id || Utilities.getUuid().slice(0, 8));
  const vals = cols.map(k => k === 'id' ? id : (row[k] == null ? '' : String(row[k]).slice(0, 5000)));
  const ids = s.getRange(1, 1, s.getLastRow(), 1).getValues().map(r => String(r[0]));
  const i = ids.indexOf(id);
  if (i > 0) s.getRange(i + 1, 1, 1, cols.length).setValues([vals]);
  else s.getRange(s.getLastRow() + 1, 1, 1, cols.length).setNumberFormat('@').setValues([vals]);
}

function del_(c, id) {
  const s = sh_(c);
  const ids = s.getRange(1, 1, s.getLastRow(), 1).getValues().map(r => String(r[0]));
  const i = ids.indexOf(id);
  if (i > 0) s.deleteRow(i + 1);
}

function signups_() {
  try {
    const id = PropertiesService.getScriptProperties().getProperty('SHEET_ID');
    if (!id) return [];
    const s = SpreadsheetApp.openById(id).getSheetByName('Show alerts');
    if (!s) return [];
    const v = s.getDataRange().getValues(); v.shift();
    return v.map(r => ({ date: r[0] instanceof Date ? Utilities.formatDate(r[0], 'Europe/Madrid', 'yyyy-MM-dd HH:mm') : String(r[0]), name: r[1], email: r[2], lang: r[3], source: r[4] }));
  } catch (e) { return []; }
}
